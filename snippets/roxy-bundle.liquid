{%- comment -%}
  Bundle & Save picker for the Roxy tanktop template.
  Rendered from a custom block in templates/product.roxy-tanktop.json only.

  Tiers are "buy:free" and live here, not in the template. Every tier except
  1:0 needs a matching automatic "Buy X get Y" discount in Shopify, otherwise
  the shown price differs from checkout. Active: "Roxy tanktop - Buy 2 Get 1 Free" and "- Buy 3 Get 2 Free".

  Usage: {% render 'roxy-bundle', product: product %}
{%- endcomment -%}
{%- liquid
  assign tiers = '1:0,2:1,3:2' | split: ','
  assign popular = 2
  assign color_index = -1
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'colo'
      assign color_index = forloop.index0
    endif
  endfor
-%}
<div class="roxy-bundle" data-roxy-bundle data-color-index="{{ color_index }}">
  <div class="roxy-bundle__title"><span>Bundle &amp; Save</span></div>

  {%- for tier in tiers -%}
    {%- liquid
      assign parts = tier | split: ':'
      assign buy = parts[0] | strip | plus: 0
      assign free = parts[1] | strip | plus: 0
    -%}
    <label class="roxy-bundle__tier{% if forloop.first %} is-selected{% endif %}" data-buy="{{ buy }}" data-free="{{ free }}">
      {%- if buy == popular -%}<span class="roxy-bundle__badge">Most popular</span>{%- endif -%}
      <span class="roxy-bundle__head">
        <input type="radio" name="roxy-bundle-tier" value="{{ buy }}" {% if forloop.first %}checked{% endif %}>
        <span class="roxy-bundle__label">
          <strong>Buy {{ buy }}{% if free > 0 %} Get {{ free }} Free{% endif %}</strong>
          <small>{% if free > 0 %}You save <span data-save></span> + Free Shipping{% else %}+ Free Shipping{% endif %}</small>
        </span>
        <span class="roxy-bundle__prices">
          <strong data-price></strong>
          {%- if free > 0 -%}<s data-compare></s>{%- endif -%}
        </span>
      </span>
      <span class="roxy-bundle__rows" data-rows></span>
    </label>
  {%- endfor -%}
  <p class="roxy-bundle__error" data-error hidden></p>
  <script type="application/json" data-product>{{ product | json }}</script>
  <script type="application/json" data-money-format>{{ shop.money_with_currency_format | json }}</script>
</div>

<style>
  .roxy-bundle { --rb-accent: #2f9e5b; --rb-soft: #e3f4e8; margin: 6px 0 4px; }
  .roxy-bundle__title { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .roxy-bundle__title::before, .roxy-bundle__title::after { content: ''; flex: 1; height: 1px; background: #ddd; }
  .roxy-bundle__tier { position: relative; display: block; overflow: visible; background-clip: padding-box; margin: 0 0 10px; padding: 14px 14px; border: 1px solid #ddd; border-radius: 8px; background: #fff; cursor: pointer; transition: border-color .15s, background .15s; }
  .roxy-bundle__tier.is-selected { border: 2px solid var(--rb-accent); background: var(--rb-soft); padding: 13px; }
  .roxy-bundle__tier:not(.is-selected):hover { border-color: var(--rb-accent); }
  .roxy-bundle__tier.is-selected .roxy-bundle__label small { color: #2a6e44; }
  .roxy-bundle__badge { position: absolute; top: -9px; right: 12px; padding: 2px 8px; border-radius: 3px; background: var(--rb-accent); color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .roxy-bundle__head { display: flex; align-items: center; gap: 10px; }
  .roxy-bundle__head input { margin: 0; accent-color: var(--rb-accent); width: 16px; height: 16px; flex-shrink: 0; }
  .roxy-bundle__label { display: flex; flex-direction: column; flex: 1; line-height: 1.3; }
  .roxy-bundle__label strong { font-size: 15px; }
  .roxy-bundle__label small { font-size: 12px; color: #666; }
  .roxy-bundle__prices { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.3; }
  .roxy-bundle__prices strong { font-size: 15px; }
  .roxy-bundle__prices s { font-size: 12px; color: #999; }
  .roxy-bundle__rows { display: none; margin-top: 12px; }
  .roxy-bundle__tier.is-selected .roxy-bundle__rows { display: block; }
  .roxy-bundle__row { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
  .roxy-bundle__num { width: 22px; font-size: 12px; font-weight: 700; color: #666; }
  .roxy-bundle__thumb { width: 40px; height: 48px; object-fit: cover; border-radius: 4px; background: #f2f2f2; flex-shrink: 0; }
  .roxy-bundle__row select { flex: 1; min-width: 0; padding: 6px 24px 6px 8px; font-size: 13px; border: 1px solid #ccc; border-radius: 4px; background-color: #fff; }
  .roxy-bundle__tier.is-selected .roxy-bundle__row select { border-color: #9fd3b2; }
  .roxy-bundle__error { margin: 0 0 10px; color: #c94a4a; font-size: 13px; }
</style>

<script>
(function () {
  var root = document.currentScript.parentElement.querySelector('[data-roxy-bundle]:not([data-ready])');
  if (!root) return;
  root.setAttribute('data-ready', '');

  // The add-to-cart form is rendered after this block, so wait for the DOM.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function init() {
    var product = JSON.parse(root.querySelector('[data-product]').textContent);
    var moneyFormat = JSON.parse(root.querySelector('[data-money-format]').textContent);
    var colorIndex = parseInt(root.dataset.colorIndex, 10);
    var section = root.closest('[data-section-type="product"]') || document;
    var form = section.querySelector('form.product-single__form');
    var errorEl = root.querySelector('[data-error]');
    var tiers = Array.prototype.slice.call(root.querySelectorAll('.roxy-bundle__tier'));
    if (!form) return;

    function formatMoney(cents) {
      var amount = (cents / 100).toFixed(2);
      var noDecimals = Math.round(cents / 100).toString();
      return moneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/, function (_, key) {
        if (key === 'amount_no_decimals') return noDecimals.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        if (key === 'amount_with_comma_separator') return amount.replace('.', ',');
        return amount.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      });
    }

    function currentVariant() {
      var id = parseInt(form.querySelector('[name="id"]').value, 10);
      return product.variants.filter(function (v) { return v.id === id; })[0] || product.variants[0];
    }

    function findVariant(options) {
      return product.variants.filter(function (v) {
        return v.options.every(function (o, i) { return o === options[i]; });
      })[0];
    }

    function variantImage(variant) {
      var img = variant && variant.featured_image ? variant.featured_image.src : product.featured_image;
      return img ? img + (img.indexOf('?') > -1 ? '&' : '?') + 'width=120' : '';
    }

    function buildRow(container, n, variant) {
      var row = document.createElement('div');
      row.className = 'roxy-bundle__row';
      row.innerHTML = '<span class="roxy-bundle__num">#' + n + '</span><img class="roxy-bundle__thumb" alt="">';
      product.options.forEach(function (name, i) {
        var select = document.createElement('select');
        select.setAttribute('aria-label', name + ' item ' + n);
        select.dataset.index = i;
        var values = [];
        product.variants.forEach(function (v) { if (values.indexOf(v.options[i]) === -1) values.push(v.options[i]); });
        values.forEach(function (value) {
          var opt = document.createElement('option');
          opt.value = value;
          opt.textContent = value;
          select.appendChild(opt);
        });
        select.value = variant.options[i];
        row.appendChild(select);
      });
      row.addEventListener('change', function () {
        row.dataset.touched = '';
        syncRow(row);
        updatePrices();
      });
      row.addEventListener('click', function (e) { e.stopPropagation(); });
      container.appendChild(row);
      syncRow(row);
    }

    function rowOptions(row) {
      return Array.prototype.map.call(row.querySelectorAll('select'), function (s) { return s.value; });
    }

    // Marks sold-out combinations and updates the thumbnail for the row's colour.
    function syncRow(row) {
      var options = rowOptions(row);
      var selects = row.querySelectorAll('select');
      selects.forEach(function (select, i) {
        Array.prototype.forEach.call(select.options, function (opt) {
          var test = options.slice();
          test[i] = opt.value;
          var v = findVariant(test);
          var soldOut = !v || !v.available;
          opt.textContent = opt.value + (soldOut ? ' (sold out)' : '');
          opt.disabled = soldOut && i !== colorIndex;
        });
      });
      var variant = findVariant(options);
      row.dataset.variantId = variant ? variant.id : '';
      row.querySelector('.roxy-bundle__thumb').src = variantImage(variant || currentVariant());
    }

    function setRowVariant(row, variant) {
      row.querySelectorAll('select').forEach(function (select, i) { select.value = variant.options[i]; });
      syncRow(row);
    }

    function selectedTier() {
      return tiers.filter(function (t) { return t.classList.contains('is-selected'); })[0];
    }

    function rowVariants(tier) {
      var rows = tier.querySelectorAll('.roxy-bundle__row');
      return Array.prototype.map.call(rows, function (row) {
        var id = parseInt(row.dataset.variantId, 10);
        return product.variants.filter(function (v) { return v.id === id; })[0] || null;
      });
    }

    function tierQty(tier) {
      return parseInt(tier.dataset.buy, 10) + parseInt(tier.dataset.free, 10);
    }

    // Shopify gives the cheapest items in a "Buy X get Y" discount for free.
    function updatePrices() {
      tiers.forEach(function (tier) {
        var qty = tierQty(tier);
        var free = parseInt(tier.dataset.free, 10) || 0;
        var variants = tier.classList.contains('is-selected') ? rowVariants(tier) : [];
        var base = currentVariant();
        var prices = [], compare = 0;
        for (var i = 0; i < qty; i++) {
          var v = variants[i] || base;
          prices.push(v.price);
          compare += Math.max(v.price, v.compare_at_price || 0);
        }
        prices.sort(function (a, b) { return a - b; });
        var total = prices.slice(free).reduce(function (sum, p) { return sum + p; }, 0);
        tier.querySelector('[data-price]').textContent = formatMoney(total);
        var compareEl = tier.querySelector('[data-compare]');
        if (compareEl) compareEl.textContent = formatMoney(compare);
        var saveEl = tier.querySelector('[data-save]');
        if (saveEl) saveEl.textContent = formatMoney(compare - total);
      });
    }

    function selectTier(tier) {
      tiers.forEach(function (t) {
        t.classList.toggle('is-selected', t === tier);
        t.querySelector('input').checked = t === tier;
      });
      var container = tier.querySelector('[data-rows]');
      if (container && !container.children.length) {
        var qty = tierQty(tier);
        for (var i = 1; i <= qty; i++) buildRow(container, i, currentVariant());
      }
      errorEl.hidden = true;
      updatePrices();
    }

    tiers.forEach(function (tier) {
      tier.addEventListener('click', function () { selectTier(tier); });
    });
    selectTier(tiers[0]);

    // Keep untouched rows in step with the main colour/size picker.
    document.addEventListener('variant:change', function (e) {
      var variant = e.detail && e.detail.variant;
      if (variant) {
        root.querySelectorAll('.roxy-bundle__row:not([data-touched])').forEach(function (row) {
          setRowVariant(row, variant);
        });
      }
      updatePrices();
    });

    form.addEventListener('submit', function (e) {
      var tier = selectedTier();
      if (!tier) return;
      e.preventDefault();
      e.stopImmediatePropagation();

      var variants = rowVariants(tier);
      var missing = variants.some(function (v) { return !v || !v.available; });
      if (missing) {
        errorEl.textContent = 'One of the selected combinations is sold out. Please pick another colour or size.';
        errorEl.hidden = false;
        return;
      }

      var counts = {};
      variants.forEach(function (v) { counts[v.id] = (counts[v.id] || 0) + 1; });
      var items = Object.keys(counts).map(function (id) { return { id: parseInt(id, 10), quantity: counts[id] }; });

      var button = form.querySelector('[data-add-to-cart]');
      if (button) button.classList.add('btn--loading');
      errorEl.hidden = true;

      fetch(theme.routes.cartAdd, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (button) button.classList.remove('btn--loading');
          if (data.status) {
            errorEl.textContent = data.description || data.message || 'Could not add to cart.';
            errorEl.hidden = false;
            return;
          }
          if (theme.settings.cartType === 'drawer') {
            form.dispatchEvent(new CustomEvent('ajaxProduct:added', {
              detail: { product: data.items ? data.items[0] : data, addToCartBtn: button },
              bubbles: true
            }));
          } else {
            window.location.href = theme.routes.cartPage;
          }
        })
        .catch(function () {
          if (button) button.classList.remove('btn--loading');
          errorEl.textContent = 'Could not add to cart. Please try again.';
          errorEl.hidden = false;
        });
    }, true);

    updatePrices();
  }
})();
</script>
