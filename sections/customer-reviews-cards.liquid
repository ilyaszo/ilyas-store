{%- liquid
  comment
    Blocks waar nog niets in staat tellen niet mee en worden niet getoond,
    zodat een half ingevulde sectie niet als lege kaarten op de winkel staat.
    In de theme-editor tonen we ze wel, anders kun je ze niet invullen.
  endcomment
  assign keep_empty = request.design_mode

  assign rating_sum = 0
  assign rating_count = 0
  for block in section.blocks
    if block.settings.quote == blank and block.settings.author == blank
      continue
    endif
    assign r = block.settings.rating | times: 10 | round
    assign rating_sum = rating_sum | plus: r
    assign rating_count = rating_count | plus: 1
  endfor

  assign has_content = false
  if rating_count > 0 or keep_empty
    assign has_content = true
  endif

  assign avg10 = 0
  if rating_count > 0
    assign avg10 = rating_sum | times: 1.0 | divided_by: rating_count | round
  endif
  assign avg_display = avg10 | divided_by: 10.0
  assign avg_pct = avg10 | times: 2

  comment
    De marquee loopt door een dubbele set kaarten, zodat hij naar het begin
    kan terugspringen zonder dat je dat ziet. De duur schaalt mee met het
    aantal kaarten, anders gaat de band sneller lopen zodra er een review bij
    komt.
  endcomment
  assign card_count = rating_count
  if keep_empty
    assign card_count = section.blocks.size
  endif

  assign marquee = section.settings.autoscroll
  assign passes = 1
  if marquee
    assign passes = 2
  endif

  assign duration = card_count | times: section.settings.scroll_speed
  if duration < 12
    assign duration = 12
  endif
-%}

{%- if has_content -%}

{%- style -%}
  .rev-cards-{{ section.id }} {
    --rev-bg: {{ section.settings.color_background }};
    --rev-card-bg: {{ section.settings.color_card }};
    --rev-card-alt: {{ section.settings.color_accent | color_mix: section.settings.color_card, 10 }};
    --rev-text: {{ section.settings.color_text }};
    --rev-muted: {{ section.settings.color_text | color_mix: section.settings.color_card, 62 }};
    --rev-line: {{ section.settings.color_text | color_mix: section.settings.color_card, 16 }};
    --rev-accent: {{ section.settings.color_accent }};
    --rev-star: {{ section.settings.color_stars }};
    --rev-star-off: {{ section.settings.color_stars | color_mix: section.settings.color_card, 22 }};
  }
{%- endstyle -%}

{% comment %} One star shape, reused by every rating row. {% endcomment %}
<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <symbol id="rev-star-{{ section.id }}" viewBox="0 0 20 20">
    <path d="M10 .9l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 14.7l-5.6 3.3 1.4-6.3L1 7.4l6.4-.6L10 .9z"/>
  </symbol>
</svg>

<div
  class="rev-cards rev-cards-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="customer-reviews-cards"
  data-shuffle="{{ section.settings.shuffle }}">

  {%- if section.settings.title != blank or section.settings.show_summary -%}
    <div class="page-width">
      <div class="rev-cards__head">
        {%- if section.settings.title != blank -%}
          <h2 class="rev-cards__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.show_summary and rating_count > 0 -%}
          <div class="rev-cards__summary">
            <span class="rev-cards__score">{{ avg_display }}</span>
            <div class="rev-cards__score-meta">
              <span class="rev-stars rev-stars--lg" style="--rev-pct: {{ avg_pct }}%" role="img" aria-label="Gemiddeld {{ avg_display }} van de 5 sterren">
                <span class="rev-stars__track" aria-hidden="true">
                  {%- for i in (1..5) -%}<svg class="rev-stars__icon"><use href="#rev-star-{{ section.id }}"/></svg>{%- endfor -%}
                </span>
                <span class="rev-stars__fill" aria-hidden="true">
                  {%- for i in (1..5) -%}<svg class="rev-stars__icon"><use href="#rev-star-{{ section.id }}"/></svg>{%- endfor -%}
                </span>
              </span>
              <span class="rev-cards__trust">
                {%- if section.settings.summary_text != blank -%}
                  {{ section.settings.summary_text | escape }}
                {%- else -%}
                  {{ rating_count }} {% if rating_count == 1 %}review{% else %}reviews{% endif %}
                {%- endif -%}
              </span>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="rev-cards__viewport{% if marquee %} rev-cards__viewport--marquee{% endif %}">
      {%- unless marquee -%}
        <button class="rev-cards__arrow rev-cards__arrow--prev" type="button" aria-label="Vorige reviews" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {%- endunless -%}

      <ul
        class="rev-cards__track{% if marquee %} rev-cards__track--marquee{% endif %}"
        role="list"
        {% if marquee %}style="--rev-duration: {{ duration }}s"{% endif %}>
        {%- for pass in (1..passes) -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.quote == blank and block.settings.author == blank and keep_empty == false -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign pct = block.settings.rating | times: 20
            comment
              Initialen uit de naam: "Kim R." wordt KR, "S.P." wordt SP.
            endcomment
            assign name_parts = block.settings.author | replace: '.', ' ' | strip | split: ' '
            assign initials = name_parts.first | slice: 0
            if name_parts.size > 1
              assign initials = name_parts.first | slice: 0 | append: name_parts.last | slice: 0, 2
            endif
          -%}
          {%- comment -%}
            De tweede set is puur visueel: geen editor-handvatten en uit de
            voorleesvolgorde, anders hoort een schermlezer elke review dubbel.
          {%- endcomment -%}
          <li class="rev-card" {% if pass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
            <div class="rev-card__top">
              <span class="rev-stars" style="--rev-pct: {{ pct }}%" role="img" aria-label="{{ block.settings.rating }} van de 5 sterren">
                <span class="rev-stars__track" aria-hidden="true">
                  {%- for i in (1..5) -%}<svg class="rev-stars__icon"><use href="#rev-star-{{ section.id }}"/></svg>{%- endfor -%}
                </span>
                <span class="rev-stars__fill" aria-hidden="true">
                  {%- for i in (1..5) -%}<svg class="rev-stars__icon"><use href="#rev-star-{{ section.id }}"/></svg>{%- endfor -%}
                </span>
              </span>
              {%- if section.settings.show_heart -%}
                <svg class="rev-card__mark" viewBox="0 0 32 24" aria-hidden="true">
                  <path d="M0 24V14.4C0 6.6 4.3 1.7 11.6 0l1.5 3.3C9 4.6 6.9 7.3 6.6 11H13v13H0zm19 0V14.4C19 6.6 23.3 1.7 30.6 0l1.4 3.3c-4.1 1.3-6.2 4-6.5 7.7H32v13H19z"/>
                </svg>
              {%- endif -%}
            </div>

            {%- if block.settings.tag != blank -%}
              <p class="rev-card__tag">{{ block.settings.tag | escape }}</p>
            {%- endif -%}

            {%- if block.settings.quote != blank -%}
              <blockquote class="rev-card__quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}

            <div class="rev-card__person">
              <span class="rev-card__initials" aria-hidden="true">{{ initials | upcase }}</span>
              <span class="rev-card__who">
                {%- if block.settings.author != blank -%}
                  <span class="rev-card__name">{{ block.settings.author | escape }}</span>
                {%- endif -%}
                {%- if block.settings.location != blank -%}
                  <span class="rev-card__location">{{ block.settings.location | escape }}</span>
                {%- endif -%}
              </span>
            </div>
          </li>
        {%- endfor -%}
        {%- endfor -%}
      </ul>

      {%- unless marquee -%}
        <button class="rev-cards__arrow rev-cards__arrow--next" type="button" aria-label="Volgende reviews" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {%- endunless -%}
    </div>
  {%- endif -%}
</div>

{%- endif -%}

{% stylesheet %}
.rev-cards {
  --rev-gap: 20px;
  background-color: var(--rev-bg);
  color: var(--rev-text);
  padding: 64px 0 68px;
  overflow: hidden;
}

/* ---- heading: title centred, score underneath ---------------------- */
.rev-cards__head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  text-align: center;
  padding-bottom: 22px;
  border-bottom: 1px solid var(--rev-line);
}

.rev-cards__title {
  margin: 0;
  font-size: clamp(26px, 3.4vw, 38px);
  line-height: 1.1;
  letter-spacing: -.01em;
  text-transform: none;
}

.rev-cards__summary {
  display: flex;
  align-items: center;
  gap: 14px;
}

.rev-cards__score {
  font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
  font-size: 52px;
  line-height: 1;
  color: var(--rev-accent);
}

.rev-cards__score-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  text-align: left;
}

.rev-cards__trust {
  font-size: 12px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--rev-muted);
}

@media (max-width: 749px) {
  .rev-cards { padding: 44px 0 48px; }
  .rev-cards__title { font-size: 22px; }
  .rev-cards__score { font-size: 42px; }
}

/* ---- stars ---------------------------------------------------------- */
.rev-stars {
  position: relative;
  display: inline-block;
  line-height: 0;
  white-space: nowrap;
}

.rev-stars__fill {
  position: absolute;
  inset: 0;
  width: var(--rev-pct, 100%);
  overflow: hidden;
  white-space: nowrap;
}

.rev-stars__track .rev-stars__icon { fill: var(--rev-star-off); }
.rev-stars__fill  .rev-stars__icon { fill: var(--rev-star); }

.rev-stars__icon {
  width: 13px;
  height: 13px;
  display: inline-block;
  vertical-align: top;
  margin-right: 1px;
}

.rev-stars--lg .rev-stars__icon { width: 17px; height: 17px; margin-right: 2px; }

/* ---- carousel ------------------------------------------------------- */
.rev-cards__viewport {
  position: relative;
  margin-top: 34px;
}

.rev-cards__track {
  display: flex;
  align-items: stretch;
  gap: var(--rev-gap);
  margin: 0;
  padding: 4px calc((100vw - 1180px) / 2) 4px;
  list-style: none;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.rev-cards__track::-webkit-scrollbar { display: none; }

@media (max-width: 1240px) {
  .rev-cards__track { padding-left: var(--rev-gap); padding-right: var(--rev-gap); }
}

/* ---- auto-scroll (marquee) ------------------------------------------ */
/* The track holds two identical sets of cards. Shifting it by exactly one
   set plus one gap lands the second set where the first began, so the reset
   at the end of the loop is invisible. */
.rev-cards__viewport--marquee { overflow: hidden; }

.rev-cards__track--marquee {
  width: max-content;
  padding-left: var(--rev-gap);
  padding-right: 0;
  overflow: visible;
  scroll-snap-type: none;
  animation: rev-marquee var(--rev-duration, 60s) linear infinite;
}

@keyframes rev-marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(calc(-50% - var(--rev-gap) / 2)); }
}

/* Let people stop the band to actually read a card. */
.rev-cards__track--marquee:hover,
.rev-cards__track--marquee:focus-within {
  animation-play-state: paused;
}

@media (prefers-reduced-motion: reduce) {
  .rev-cards__track--marquee {
    animation: none;
    width: auto;
    overflow-x: auto;
  }
}

/* ---- card ----------------------------------------------------------- */
/* Flat, outlined cards with a coloured top edge; every other card gets a
   tint so the band reads as a rhythm instead of a row of identical boxes. */
.rev-card {
  flex: 0 0 300px;
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  background: var(--rev-card-bg);
  border: 1px solid var(--rev-line);
  border-top: 3px solid var(--rev-accent);
  border-radius: 2px;
  padding: 22px 24px 20px;
}

.rev-card:nth-child(even) { background: var(--rev-card-alt); }

@media (max-width: 600px) {
  .rev-card { flex-basis: 80vw; }
}

.rev-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.rev-card__mark {
  width: 26px;
  height: 20px;
  flex-shrink: 0;
  fill: var(--rev-accent);
  opacity: .35;
}

.rev-card__tag {
  margin: 16px 0 0;
  font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
  font-size: 19px;
  line-height: 1.25;
  text-transform: none;
  letter-spacing: 0;
}

.rev-card__tag::first-letter { text-transform: uppercase; }

/* flex: 1 pushes the name to the bottom even when quotes differ in length */
.rev-card__quote {
  flex: 1 1 auto;
  margin: 10px 0 0;
  padding: 0;
  border: 0;
  font-size: 14px;
  font-style: normal;
  line-height: 1.65;
  color: var(--rev-muted);
}

.rev-card__quote p { margin: 0 0 .6em; }
.rev-card__quote p:last-child { margin-bottom: 0; }

.rev-card__person {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 20px;
}

.rev-card__initials {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--rev-text);
  color: var(--rev-card-bg);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .04em;
}

.rev-card__who {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0 6px;
  font-size: 13px;
}

.rev-card__name { font-weight: 600; }
.rev-card__location { color: var(--rev-muted); text-transform: capitalize; }
.rev-card__location::before { content: '\00B7'; margin-right: 6px; }

/* ---- arrows --------------------------------------------------------- */
.rev-cards__arrow {
  position: absolute;
  top: 50%;
  z-index: 2;
  width: 40px;
  height: 40px;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1px solid var(--rev-line);
  border-radius: 2px;
  background: var(--rev-card-bg);
  color: var(--rev-text);
  cursor: pointer;
}

.rev-cards__arrow[hidden] { display: none; }
.rev-cards__arrow--prev { left: 12px; }
.rev-cards__arrow--next { right: 12px; }
.rev-cards__arrow svg { width: 18px; height: 18px; }

@media (max-width: 749px) {
  .rev-cards__arrow { display: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function init(root) {
    if (!root || root.dataset.revReady === '1') return;
    root.dataset.revReady = '1';

    var track = root.querySelector('.rev-cards__track');
    if (!track) return;

    // The marquee runs on CSS alone and relies on the two card sets staying
    // in order, so there is nothing for this script to do there.
    if (track.classList.contains('rev-cards__track--marquee')) return;

    // Varying the order keeps the block from looking static on repeat visits.
    // Off inside the theme editor so blocks stay where the merchant put them.
    if (root.dataset.shuffle === 'true' && !(window.Shopify && window.Shopify.designMode)) {
      var cards = Array.prototype.slice.call(track.children);
      for (var i = cards.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        track.appendChild(cards[j]);
        cards.splice(j, 1);
      }
      cards.forEach(function (c) { track.appendChild(c); });
    }

    var prev = root.querySelector('.rev-cards__arrow--prev');
    var next = root.querySelector('.rev-cards__arrow--next');
    if (!prev || !next) return;

    function step() {
      var card = track.querySelector('.rev-card');
      if (!card) return track.clientWidth;
      return card.getBoundingClientRect().width + 20;
    }

    function sync() {
      var overflows = track.scrollWidth - track.clientWidth > 4;
      prev.hidden = !overflows || track.scrollLeft <= 4;
      next.hidden = !overflows || track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    }

    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }

  function initAll() {
    document.querySelectorAll('[data-section-type="customer-reviews-cards"]').forEach(init);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', function (e) {
    init(e.target.querySelector('[data-section-type="customer-reviews-cards"]'));
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Customer review cards",
  "class": "index-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What customers say about us"
    },
    {
      "type": "header",
      "content": "Summary line"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show average rating",
      "info": "The score is calculated from the reviews below, so it always matches what shoppers can read.",
      "default": true
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Text next to the score",
      "info": "Only state a customer count you can back up with order data."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "autoscroll",
      "label": "Slowly scroll to the left",
      "info": "Pauses when a visitor hovers a card. Replaces the arrows.",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "info": "Seconds each card takes to cross the screen. Higher is slower.",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "shuffle",
      "label": "Shuffle card order on each visit",
      "info": "Only applies when auto-scroll is off.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_heart",
      "label": "Show quote mark on cards",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Section background",
      "default": "#fdf4ec"
    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#3b2f26"
    },
    {
      "type": "color",
      "id": "color_stars",
      "label": "Stars",
      "default": "#3b2f26"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "info": "Score, top edge of the cards and the quote mark.",
      "default": "#b07a52"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "paragraph",
          "content": "Use a real review. Fabricated customer reviews are illegal in the EU, UK, US and Australia."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location"
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Rating",
          "default": "5",
          "options": [
            { "value": "5", "label": "5 stars" },
            { "value": "4.5", "label": "4.5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "3.5", "label": "3.5 stars" },
            { "value": "3", "label": "3 stars" },
            { "value": "2", "label": "2 stars" },
            { "value": "1", "label": "1 star" }
          ]
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Label under the review",
          "info": "Short summary, e.g. \"Fast delivery\"."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer review cards",
      "category": "Text",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
