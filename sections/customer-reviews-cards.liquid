{%- liquid
  comment
    Blocks waar nog niets in staat tellen niet mee en worden niet getoond,
    zodat een half ingevulde sectie niet als lege kaarten op de winkel staat.
    In de theme-editor tonen we ze wel, anders kun je ze niet invullen.
  endcomment
  assign keep_empty = request.design_mode

  assign rating_sum = 0
  assign rating_count = 0
  for block in section.blocks
    if block.settings.quote == blank and block.settings.author == blank
      continue
    endif
    assign r = block.settings.rating | times: 10 | round
    assign rating_sum = rating_sum | plus: r
    assign rating_count = rating_count | plus: 1
  endfor

  assign has_content = false
  if rating_count > 0 or keep_empty
    assign has_content = true
  endif

  assign avg10 = 0
  if rating_count > 0
    assign avg10 = rating_sum | times: 1.0 | divided_by: rating_count | round
  endif
  assign avg_display = avg10 | divided_by: 10.0
  assign avg_pct = avg10 | times: 2
-%}

{%- if has_content -%}

{%- style -%}
  .rev-cards-{{ section.id }} {
    --rev-bg: {{ section.settings.color_background }};
    --rev-card-bg: {{ section.settings.color_card }};
    --rev-text: {{ section.settings.color_text }};
    --rev-muted: {{ section.settings.color_text | color_mix: section.settings.color_card, 62 }};
    --rev-line: {{ section.settings.color_text | color_mix: section.settings.color_card, 14 }};
    --rev-star: {{ section.settings.color_stars }};
    --rev-star-off: {{ section.settings.color_stars | color_mix: section.settings.color_card, 22 }};
  }
{%- endstyle -%}

{% comment %} One star shape, reused by every rating row. {% endcomment %}
<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <symbol id="rev-star-{{ section.id }}" viewBox="0 0 20 20">
    <path d="M10 .9l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 14.7l-5.6 3.3 1.4-6.3L1 7.4l6.4-.6L10 .9z"/>
  </symbol>
</svg>

<div
  class="rev-cards rev-cards-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="customer-reviews-cards"
  data-shuffle="{{ section.settings.shuffle }}">

  {%- if section.settings.title != blank or section.settings.show_summary -%}
    <div class="page-width">
      <div class="rev-cards__head">
        {%- if section.settings.title != blank -%}
          <h2 class="rev-cards__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.show_summary and rating_count > 0 -%}
          <div class="rev-cards__summary">
            <span class="rev-stars rev-stars--lg" style="--rev-pct: {{ avg_pct }}%" role="img" aria-label="Gemiddeld {{ avg_display }} van de 5 sterren">
              <span class="rev-stars__track" aria-hidden="true">
                {%- for i in (1..5) -%}<svg class="rev-stars__icon"><use href="#rev-star-{{ section.id }}"/></svg>{%- endfor -%}
              </span>
              <span class="rev-stars__fill" aria-hidden="true">
                {%- for i in (1..5) -%}<svg class="rev-stars__icon"><use href="#rev-star-{{ section.id }}"/></svg>{%- endfor -%}
              </span>
            </span>
            <span class="rev-cards__score">{{ avg_display }}</span>
            {%- if section.settings.summary_text != blank -%}
              <span class="rev-cards__divider" aria-hidden="true"></span>
              <span class="rev-cards__trust">{{ section.settings.summary_text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="rev-cards__viewport">
      <button class="rev-cards__arrow rev-cards__arrow--prev" type="button" aria-label="Vorige reviews" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <ul class="rev-cards__track" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.quote == blank and block.settings.author == blank and keep_empty == false -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign pct = block.settings.rating | times: 20 -%}
          <li class="rev-card" {{ block.shopify_attributes }}>
            <div class="rev-card__person">
              {%- if block.settings.avatar != blank -%}
                <div class="rev-card__avatar">
                  {%- render 'image-element',
                    img: block.settings.avatar,
                    sizeVariable: '52px',
                    fallback: '52px',
                    widths: '52, 104, 156'
                  -%}
                </div>
              {%- else -%}
                <div class="rev-card__avatar rev-card__avatar--initial" aria-hidden="true">
                  {{ block.settings.author | strip | slice: 0 | upcase }}
                </div>
              {%- endif -%}

              <div class="rev-card__who">
                {%- if block.settings.author != blank -%}
                  <span class="rev-card__name">{{ block.settings.author | escape }}</span>
                {%- endif -%}
                {%- if block.settings.location != blank -%}
                  <span class="rev-card__location">{{ block.settings.location | escape }}</span>
                {%- endif -%}
              </div>
            </div>

            <span class="rev-stars" style="--rev-pct: {{ pct }}%" role="img" aria-label="{{ block.settings.rating }} van de 5 sterren">
              <span class="rev-stars__track" aria-hidden="true">
                {%- for i in (1..5) -%}<svg class="rev-stars__icon"><use href="#rev-star-{{ section.id }}"/></svg>{%- endfor -%}
              </span>
              <span class="rev-stars__fill" aria-hidden="true">
                {%- for i in (1..5) -%}<svg class="rev-stars__icon"><use href="#rev-star-{{ section.id }}"/></svg>{%- endfor -%}
              </span>
            </span>

            {%- if block.settings.quote != blank -%}
              <blockquote class="rev-card__quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}

            {%- if block.settings.tag != blank -%}
              <div class="rev-card__foot">
                <span class="rev-card__tag">{{ block.settings.tag | escape }}</span>
                {%- if section.settings.show_heart -%}
                  <svg class="rev-card__heart" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21s-7.5-4.6-9.6-9A5.1 5.1 0 0112 5.4 5.1 5.1 0 0121.6 12c-2.1 4.4-9.6 9-9.6 9z"/>
                  </svg>
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <button class="rev-cards__arrow rev-cards__arrow--next" type="button" aria-label="Volgende reviews" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  {%- endif -%}
</div>

{%- endif -%}

{% stylesheet %}
.rev-cards {
  background-color: var(--rev-bg);
  color: var(--rev-text);
  padding: 54px 0 60px;
  overflow: hidden;
}

.rev-cards__head { text-align: center; }

.rev-cards__title {
  margin: 0 0 14px;
  letter-spacing: .04em;
}

.rev-cards__summary {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-size: 15px;
}

.rev-cards__score { font-weight: 600; font-size: 19px; }

.rev-cards__divider {
  width: 1px;
  height: 18px;
  background: var(--rev-line);
}

.rev-cards__trust { color: var(--rev-muted); }

/* ---- stars ---------------------------------------------------------- */
.rev-stars {
  position: relative;
  display: inline-block;
  line-height: 0;
  white-space: nowrap;
}

.rev-stars__fill {
  position: absolute;
  inset: 0;
  width: var(--rev-pct, 100%);
  overflow: hidden;
  white-space: nowrap;
}

.rev-stars__track .rev-stars__icon { fill: var(--rev-star-off); }
.rev-stars__fill  .rev-stars__icon { fill: var(--rev-star); }

.rev-stars__icon {
  width: 15px;
  height: 15px;
  display: inline-block;
  vertical-align: top;
  margin-right: 2px;
}

.rev-stars--lg .rev-stars__icon { width: 19px; height: 19px; margin-right: 3px; }

/* ---- carousel ------------------------------------------------------- */
.rev-cards__viewport {
  position: relative;
  margin-top: 30px;
}

.rev-cards__track {
  display: flex;
  gap: 22px;
  margin: 0;
  padding: 4px calc((100vw - 1180px) / 2) 4px;
  list-style: none;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.rev-cards__track::-webkit-scrollbar { display: none; }

@media (max-width: 1240px) {
  .rev-cards__track { padding-left: 22px; padding-right: 22px; }
}

.rev-card {
  flex: 0 0 272px;
  scroll-snap-align: center;
  display: flex;
  flex-direction: column;
  background: var(--rev-card-bg);
  border-radius: 8px;
  padding: 22px 22px 18px;
  box-shadow: 0 2px 14px rgba(0, 0, 0, .07);
}

@media (max-width: 600px) {
  .rev-card { flex-basis: 78vw; }
}

.rev-card__person {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

.rev-card__avatar {
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
}

.rev-card__avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.rev-card__avatar--initial {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--rev-line);
  font-size: 20px;
  font-weight: 600;
}

.rev-card__who { display: flex; flex-direction: column; gap: 2px; }
.rev-card__name { font-weight: 600; font-size: 16px; }
.rev-card__location { font-size: 13px; color: var(--rev-muted); }

/* flex: 1 lets the footer sit on the baseline even when quotes differ in length */
.rev-card__quote {
  flex: 1 1 auto;
  margin: 12px 0 0;
  padding: 0;
  border: 0;
  font-size: 15px;
  line-height: 1.55;
}

.rev-card__quote p { margin: 0 0 .6em; }
.rev-card__quote p:last-child { margin-bottom: 0; }

.rev-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid var(--rev-line);
}

.rev-card__tag {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .07em;
  text-transform: uppercase;
}

.rev-card__heart {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  fill: currentColor;
}

/* ---- arrows --------------------------------------------------------- */
.rev-cards__arrow {
  position: absolute;
  top: 50%;
  z-index: 2;
  width: 40px;
  height: 40px;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--rev-card-bg);
  color: var(--rev-text);
  box-shadow: 0 2px 10px rgba(0, 0, 0, .14);
  cursor: pointer;
}

.rev-cards__arrow[hidden] { display: none; }
.rev-cards__arrow--prev { left: 12px; }
.rev-cards__arrow--next { right: 12px; }
.rev-cards__arrow svg { width: 18px; height: 18px; }

@media (max-width: 749px) {
  .rev-cards__arrow { display: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function init(root) {
    if (!root || root.dataset.revReady === '1') return;
    root.dataset.revReady = '1';

    var track = root.querySelector('.rev-cards__track');
    if (!track) return;

    // Varying the order keeps the block from looking static on repeat visits.
    // Off inside the theme editor so blocks stay where the merchant put them.
    if (root.dataset.shuffle === 'true' && !(window.Shopify && window.Shopify.designMode)) {
      var cards = Array.prototype.slice.call(track.children);
      for (var i = cards.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        track.appendChild(cards[j]);
        cards.splice(j, 1);
      }
      cards.forEach(function (c) { track.appendChild(c); });
    }

    var prev = root.querySelector('.rev-cards__arrow--prev');
    var next = root.querySelector('.rev-cards__arrow--next');
    if (!prev || !next) return;

    function step() {
      var card = track.querySelector('.rev-card');
      if (!card) return track.clientWidth;
      return card.getBoundingClientRect().width + 22;
    }

    function sync() {
      var overflows = track.scrollWidth - track.clientWidth > 4;
      prev.hidden = !overflows || track.scrollLeft <= 4;
      next.hidden = !overflows || track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    }

    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }

  function initAll() {
    document.querySelectorAll('[data-section-type="customer-reviews-cards"]').forEach(init);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', function (e) {
    init(e.target.querySelector('[data-section-type="customer-reviews-cards"]'));
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Customer review cards",
  "class": "index-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What customers say about us"
    },
    {
      "type": "header",
      "content": "Summary line"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show average rating",
      "info": "The score is calculated from the reviews below, so it always matches what shoppers can read.",
      "default": true
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Text next to the score",
      "info": "Only state a customer count you can back up with order data."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "shuffle",
      "label": "Shuffle card order on each visit",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_heart",
      "label": "Show heart icon on cards",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Section background",
      "default": "#fdf4ec"
    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#3b2f26"
    },
    {
      "type": "color",
      "id": "color_stars",
      "label": "Stars",
      "default": "#3b2f26"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "paragraph",
          "content": "Use a real review. Fabricated customer reviews are illegal in the EU, UK, US and Australia."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo",
          "info": "Only with the customer's permission. Leave empty to show their initial instead."
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Rating",
          "default": "5",
          "options": [
            { "value": "5", "label": "5 stars" },
            { "value": "4.5", "label": "4.5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "3.5", "label": "3.5 stars" },
            { "value": "3", "label": "3 stars" },
            { "value": "2", "label": "2 stars" },
            { "value": "1", "label": "1 star" }
          ]
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Label under the review",
          "info": "Short summary, e.g. \"Fast delivery\"."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer review cards",
      "category": "Text",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
